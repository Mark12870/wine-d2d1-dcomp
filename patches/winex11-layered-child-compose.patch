+static void union_rect( RECT *dst, const RECT *src1, const RECT *src2 )
+{
+    if (IsRectEmpty( src1 )) *dst = *src2;
+    else if (!IsRectEmpty( src2 ))
+        SetRect( dst, min( src1->left, src2->left ), min( src1->top, src2->top ),
+                 max( src1->right, src2->right ), max( src1->bottom, src2->bottom ) );
+    else *dst = *src1;
