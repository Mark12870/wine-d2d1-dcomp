+    LOAD( xd, XDamageDestroy );
+#undef LOAD
+    if (!pXRenderQueryExtension( gdi_display, &error_base, &error_base )) return;
+    if (!(damage_display = XOpenDisplay( XDisplayString( gdi_display ) ))) return;
+    if (!pXDamageQueryExtension( damage_display, &damage_event_base, &error_base )) return;
+    if (pthread_create( &thread, NULL, listen_damage, NULL )) return;
+    pthread_detach( thread );
+    redirect_ready = TRUE;
+}
+
+static struct redirect *find_redirect( HWND hwnd )
+{
+    unsigned int i;
+
+    for (i = 0; i < MAX_REDIRECTS; i++) if (redirects[i].hwnd == hwnd) return &redirects[i];
+    return NULL;
+}
+
+static void retire_pixmap( Pixmap pixmap )
+{
+    unsigned int i, oldest = 0;
+
+    if (!pixmap) return;
+    for (i = 0; i < ARRAY_SIZE(retired); i++)
+    {
+        if (!retired[i].pixmap) break;
+        if ((int)(retired[i].since - retired[oldest].since) < 0) oldest = i;
+    }
+    if (i == ARRAY_SIZE(retired))
+    {
+        XFreePixmap( gdi_display, retired[oldest].pixmap );
+        i = oldest;
+    }
+    retired[i].pixmap = pixmap;
+    retired[i].since = NtGetTickCount();
+}
+
+static void reap_retired(void)
+{
+    DWORD now = NtGetTickCount();
+    unsigned int i;
+
+    for (i = 0; i < ARRAY_SIZE(retired); i++)
+    {
+        if (!retired[i].pixmap || now - retired[i].since < RETIRE_TICKS) continue;
+        XFreePixmap( gdi_display, retired[i].pixmap );
+        retired[i].pixmap = 0;
+    }
+}
+
+static void release_buffers( struct redirect *r, BOOL retire )
+{
+    if (r->backing_pict) pXRenderFreePicture( gdi_display, r->backing_pict );
+    if (r->overlay_pict) pXRenderFreePicture( gdi_display, r->overlay_pict );
+    if (r->scratch_pict) pXRenderFreePicture( gdi_display, r->scratch_pict );
+    if (r->overlay_gc) XFreeGC( gdi_display, r->overlay_gc );
+    if (retire)
+    {
+        retire_pixmap( r->backing );
+        retire_pixmap( r->overlay );
+    }
+    else
+    {
+        if (r->backing) XFreePixmap( gdi_display, r->backing );
+        if (r->overlay) XFreePixmap( gdi_display, r->overlay );
+    }
+    if (r->scratch) XFreePixmap( gdi_display, r->scratch );
+    r->backing = r->overlay = r->scratch = 0;
+    r->backing_pict = r->overlay_pict = r->scratch_pict = 0;
+    r->overlay_gc = 0;
+}
+
+static BOOL create_buffers( struct redirect *r, const XVisualInfo *vis, Pixmap previous, int previous_width,
+                            int previous_height )
+{
+    XRenderPictFormat *format = pXRenderFindVisualFormat( gdi_display, vis->visual );
+    XRenderPictFormat *argb = pXRenderFindStandardFormat( gdi_display, PictStandardARGB32 );
+
+    if (!format || !argb) return FALSE;
+    r->backing = XCreatePixmap( gdi_display, r->window, r->width, r->height, r->depth );
+    r->scratch = XCreatePixmap( gdi_display, r->window, r->width, r->height, r->depth );
+    r->overlay = XCreatePixmap( gdi_display, r->window, r->width, r->height, 32 );
+    if (previous)
+        XCopyArea( gdi_display, previous, r->backing, r->gc, 0, 0, min( r->width, previous_width ),
+                   min( r->height, previous_height ), 0, 0 );
+    else
+        XCopyArea( gdi_display, r->window, r->backing, r->gc, 0, 0, r->width, r->height, 0, 0 );
+    r->backing_pict = pXRenderCreatePicture( gdi_display, r->backing, format, 0, NULL );
+    r->scratch_pict = pXRenderCreatePicture( gdi_display, r->scratch, format, 0, NULL );
+    r->overlay_pict = pXRenderCreatePicture( gdi_display, r->overlay, argb, 0, NULL );
+    r->overlay_gc = XCreateGC( gdi_display, r->overlay, 0, NULL );
+    return TRUE;
+}
+
+static void compose( struct redirect *r, const RECT *area )
+{
+    RECT rect = { 0, 0, r->width, r->height };
+    int width, height;
+
+    if (!intersect_rect( &rect, &rect, area )) return;
+    width = rect.right - rect.left;
+    height = rect.bottom - rect.top;
+    pXRenderComposite( gdi_display, PictOpSrc, r->backing_pict, None, r->scratch_pict,
+                       rect.left, rect.top, 0, 0, rect.left, rect.top, width, height );
+    pXRenderComposite( gdi_display, PictOpOver, r->overlay_pict, None, r->scratch_pict,
+                       rect.left, rect.top, 0, 0, rect.left, rect.top, width, height );
+    XCopyArea( gdi_display, r->scratch, r->window, r->gc, rect.left, rect.top, width, height,
+               rect.left, rect.top );
+}
+
+static UINT collect_layered( HWND parent, HWND *children, UINT count, UINT depth )
+{
+    HWND child, list[64];
+    UINT i = 0;
+
+    for (child = NtUserGetWindowRelative( parent, GW_CHILD ); child && i < ARRAY_SIZE(list);
+         child = NtUserGetWindowRelative( child, GW_HWNDNEXT ))
+        list[i++] = child;
+
+    while (i-- && count < MAX_LAYERED)
+    {
+        if (!(NtUserGetWindowLongW( list[i], GWL_STYLE ) & WS_VISIBLE)) continue;
+        if (is_ulw_child( list[i] )) children[count++] = list[i];
+        else if (depth) count = collect_layered( list[i], children, count, depth - 1 );
+    }
+    return count;
+}
+
+static void draw_layered( struct redirect *r, HWND child, const POINT *origin, UINT dpi )
+{
+    struct window_surface *surface;
+    DIBSECTION dib;
+    XImage *image;
+    Pixmap pixmap;
+    Picture picture;
+    RECT rect;
+    int width, height;
+
+    if (!NtUserGetWindowRect( child, &rect, dpi )) return;
+    if (!(surface = get_composed_surface( child ))) return;
+    OffsetRect( &rect, -origin->x, -origin->y );
+    width = min( rect.right - rect.left, surface->rect.right - surface->rect.left );
+    height = min( rect.bottom - rect.top, surface->rect.bottom - surface->rect.top );
+
+    window_surface_lock( surface );
+    if (width > 0 && height > 0 &&
+        NtGdiExtGetObjectW( surface->color_bitmap, sizeof(dib), &dib ) == sizeof(dib) &&
+        dib.dsBm.bmBits && dib.dsBm.bmBitsPixel == 32 &&
+        (image = XCreateImage( gdi_display, NULL, 32, ZPixmap, 0, dib.dsBm.bmBits, dib.dsBm.bmWidth,
+                               dib.dsBm.bmHeight, 32, dib.dsBm.bmWidthBytes )))
+    {
+        image->byte_order = LSBFirst;
+        pixmap = XCreatePixmap( gdi_display, r->window, width, height, 32 );
+        XPutImage( gdi_display, pixmap, r->overlay_gc, image, 0, 0, 0, 0, width, height );
+        image->data = NULL;
+        XDestroyImage( image );
+        picture = pXRenderCreatePicture( gdi_display, pixmap,
+                                         pXRenderFindStandardFormat( gdi_display, PictStandardARGB32 ), 0, NULL );
+        pXRenderComposite( gdi_display, PictOpOver, picture, None, r->overlay_pict, 0, 0, 0, 0,
+                           rect.left, rect.top, width, height );
+        pXRenderFreePicture( gdi_display, picture );
+        XFreePixmap( gdi_display, pixmap );
+        SetRect( &rect, rect.left, rect.top, rect.left + width, rect.top + height );
+        union_rect( &r->layered, &r->layered, &rect );
+    }
+    window_surface_unlock( surface );
+    window_surface_release( surface );
+}
+
+static void draw_overlay( struct redirect *r, const HWND *children, UINT count, const POINT *origin, UINT dpi )
+{
+    static const XRenderColor transparent;
+    UINT i;
+
+    SetRectEmpty( &r->layered );
+    pXRenderFillRectangle( gdi_display, PictOpSrc, r->overlay_pict, &transparent, 0, 0, r->width, r->height );
+    for (i = 0; i < count; i++) draw_layered( r, children[i], origin, dpi );
+}
+
+static void stop_redirect( struct redirect *r )
+{
+    RECT all = { 0, 0, r->width, r->height };
+
+    TRACE( "hwnd %p stops composing its layered children\n", r->hwnd );
+    NtUserRemoveProp( r->hwnd, backing_prop );
+    pXDamageDestroy( damage_display, r->damage );
+    XFlush( damage_display );
+    XCopyArea( gdi_display, r->backing, r->window, r->gc, 0, 0, all.right, all.bottom, 0, 0 );
+    XFreeGC( gdi_display, r->gc );
+    release_buffers( r, TRUE );
+    memset( r, 0, sizeof(*r) );
+}
+
+static struct redirect *start_redirect( HWND hwnd, const struct top_level *data, int width, int height )
+{
+    struct redirect *r = find_redirect( 0 );
+
+    if (!r) return NULL;
+    r->hwnd = hwnd;
+    r->window = data->window;
+    r->width = width;
+    r->height = height;
+    r->depth = data->vis.depth;
+    r->gc = XCreateGC( gdi_display, r->window, 0, NULL );
+    XSetSubwindowMode( gdi_display, r->gc, IncludeInferiors );
+    XSetGraphicsExposures( gdi_display, r->gc, False );
+    if (!create_buffers( r, &data->vis, 0, 0, 0 ))
+    {
+        XFreeGC( gdi_display, r->gc );
+        release_buffers( r, FALSE );
+        memset( r, 0, sizeof(*r) );
+        return NULL;
+    }
+    XSync( gdi_display, False );
+    r->damage = pXDamageCreate( damage_display, r->backing, XDamageReportRawRectangles );
+    XFlush( damage_display );
+    NtUserSetProp( hwnd, backing_prop, (HANDLE)r->backing );
+    TRACE( "hwnd %p composes its layered children, backing %lx\n", hwnd, r->backing );
+    return r;
+}
+
+static void resize_redirect( struct redirect *r, const struct top_level *data, int width, int height )
+{
+    struct redirect previous = *r;
+
+    pXDamageDestroy( damage_display, r->damage );
+    r->width = width;
+    r->height = height;
+    r->backing = r->overlay = r->scratch = 0;
+    r->backing_pict = r->overlay_pict = r->scratch_pict = 0;
+    r->overlay_gc = 0;
+    create_buffers( r, &data->vis, previous.backing, previous.width, previous.height );
+    XSync( gdi_display, False );
+    r->damage = pXDamageCreate( damage_display, r->backing, XDamageReportRawRectangles );
+    XFlush( damage_display );
+    NtUserSetProp( r->hwnd, backing_prop, (HANDLE)r->backing );
+    release_buffers( &previous, TRUE );
+}
+
+/* bring the composition of hwnd, a top-level of this process, in line with its
+ * visible layered children; FALSE when it is not composed */
+BOOL x11drv_redirect_update( HWND hwnd )
+{
+    HWND children[MAX_LAYERED];
+    struct x11drv_win_data *win_data;
+    struct top_level top, *data = &top;
+    struct redirect *r;
+    RECT old, area, window_rect;
+    POINT origin;
+    UINT count, dpi;
+    Window root;
+    int x, y;
+    unsigned int width, height, border, depth;
+    BOOL composed;
+
+    pthread_once( &redirect_once, redirect_load );
+    if (!redirect_ready) return FALSE;
+
+    dpi = NtUserGetWinMonitorDpi( hwnd, MDT_RAW_DPI );
+    count = NtUserGetWindowLongW( hwnd, GWL_STYLE ) & WS_VISIBLE ? collect_layered( hwnd, children, 0, 4 ) : 0;
+    if (!NtUserGetWindowRect( hwnd, &window_rect, dpi )) return FALSE;
+    if (!(win_data = get_win_data( hwnd ))) return FALSE;
+    top.window = win_data->whole_window;
+    top.vis = win_data->vis;
+    top.rects = win_data->rects;
+    release_win_data( win_data );
+
+    pthread_mutex_lock( &redirect_mutex );
+    reap_retired();
+    r = find_redirect( hwnd );
+    if (!count || !data->window || data->window == root_window)
+    {
+        if (r) stop_redirect( r );
+        r = NULL;
+    }
+    else if (XGetGeometry( gdi_display, data->window, &root, &x, &y, &width, &height, &border, &depth ))
+    {
+        if (!r) r = start_redirect( hwnd, data, width, height );
+        else if (r->width != width || r->height != height) resize_redirect( r, data, width, height );
+    }
+    if (r)
+    {
+        origin.x = window_rect.left + data->rects.visible.left - data->rects.window.left;
+        origin.y = window_rect.top + data->rects.visible.top - data->rects.window.top;
+        old = r->layered;
+        draw_overlay( r, children, count, &origin, dpi );
+        union_rect( &area, &old, &r->layered );
+        compose( r, &area );
+        XFlush( gdi_display );
+    }
+    composed = r != NULL;
+    pthread_mutex_unlock( &redirect_mutex );
+    return composed;
+}
+
+void x11drv_redirect_destroy( HWND hwnd )
+{
+    struct redirect *r;
+
+    if (!redirect_ready) return;
+    pthread_mutex_lock( &redirect_mutex );
+    if ((r = find_redirect( hwnd )))
+    {
+        NtUserRemoveProp( hwnd, backing_prop );
+        pXDamageDestroy( damage_display, r->damage );
+        XFlush( damage_display );
+        XFreeGC( gdi_display, r->gc );
+        release_buffers( r, TRUE );
+        memset( r, 0, sizeof(*r) );
+    }
+    pthread_mutex_unlock( &redirect_mutex );
+}
+
+/* the drawable that painters of hwnd, a top-level of this process, write into */
+Drawable x11drv_redirect_target( HWND hwnd, Drawable window )
+{
+    struct redirect *r;
+    Drawable target = window;
+
+    if (!redirect_ready) return window;
+    pthread_mutex_lock( &redirect_mutex );
+    if ((r = find_redirect( hwnd )) && r->window == window) target = r->backing;
+    pthread_mutex_unlock( &redirect_mutex );
+    return target;
+}
+
+static void handle_damage( const XDamageNotifyEvent *damage )
+{
+    struct redirect *r;
+    RECT rect;
+    unsigned int i;
+
+    pthread_mutex_lock( &redirect_mutex );
+    for (i = 0; i < MAX_REDIRECTS; i++)
+    {
+        r = &redirects[i];
+        if (!r->hwnd || r->damage != damage->damage) continue;
+        SetRect( &rect, damage->area.x, damage->area.y, damage->area.x + damage->area.width,
+                 damage->area.y + damage->area.height );
+        union_rect( &r->pending, &r->pending, &rect );
+        if (damage->more) break;
+        compose( r, &r->pending );
+        SetRectEmpty( &r->pending );
+        XFlush( gdi_display );
+        break;
+    }
+    pthread_mutex_unlock( &redirect_mutex );
+}
+
+static void *listen_damage( void *arg )
+{
+    XEvent event;
+
+    for (;;)
+    {
+        XNextEvent( damage_display, &event );
+        if (event.type == damage_event_base + XDamageNotify) handle_damage( (XDamageNotifyEvent *)&event );
+    }
+    return NULL;
+}
+
+#else
+
+BOOL x11drv_redirect_update( HWND hwnd )
+{
+    return FALSE;
+}
+
+void x11drv_redirect_destroy( HWND hwnd )
+{
+}
+
+Drawable x11drv_redirect_target( HWND hwnd, Drawable window )
+{
+    return window;
+}
+
+#endif
+
+/* the drawable that painters of hwnd, a top-level of another process, write into */
+Drawable x11drv_redirect_foreign_target( HWND hwnd, Drawable window )
+{
+    Drawable backing = (Drawable)NtUserGetProp( hwnd, backing_prop );
+
+    return backing ? backing : window;
+}
