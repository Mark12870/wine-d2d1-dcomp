+/* A layered child painted through UpdateLayeredWindow() (Windows 8 and later) is
+ * composed by the DWM over whatever its parent presents, alpha included.  Here it
+ * has no X window of its own (X11DRV_CreateWindowSurface()): an X window would be
+ * a separate top-level that the window manager places anywhere, and the parent's
+ * visible region would lose the child's rectangle all the same.  The iZotope
+ * "Glass" plug-in editors show their consent and authorisation dialogs this way
+ * over an OpenGL canvas, and both came up black with the dialog nowhere to be
+ * seen.  Compose it in the parent's present instead. */
+BOOL is_ulw_child( HWND hwnd )
+{
+    HWND parent = NtUserGetAncestor( hwnd, GA_PARENT );
+
+    if (!parent || parent == NtUserGetDesktopWindow()) return FALSE;
+    if (!(NtUserGetWindowLongW( hwnd, GWL_EXSTYLE ) & WS_EX_LAYERED)) return FALSE;
+    return !NtUserGetLayeredWindowAttributes( hwnd, NULL, NULL, NULL );
+}
+
+/* the visible layered children of hwnd, bottom-most first, with their window
+ * rects in hwnd's client coordinates */
+static UINT get_ulw_children( HWND hwnd, UINT dpi, HWND *children, RECT *rects, UINT max )
+{
+    HWND child, list[64];
+    UINT count = 0, i = 0;
+
+    for (child = NtUserGetWindowRelative( hwnd, GW_CHILD ); child && i < ARRAY_SIZE(list);
+         child = NtUserGetWindowRelative( child, GW_HWNDNEXT ))
+        list[i++] = child;
+
+    while (i-- && count < max)
+    {
+        if (!(NtUserGetWindowLongW( list[i], GWL_STYLE ) & WS_VISIBLE)) continue;
+        if (!is_ulw_child( list[i] )) continue;
+        if (!NtUserGetWindowRect( list[i], &rects[count], dpi )) continue;
+        NtUserMapWindowPoints( 0, hwnd, (POINT *)&rects[count], 2, dpi );
+        children[count++] = list[i];
+    }
+    return count;
+}
+
+static void blend_ulw_child( HDC hdc, HWND child, const RECT *rect )
+{
+    BLENDFUNCTION blend = { AC_SRC_OVER, 0, 255, AC_SRC_ALPHA };
+    struct window_surface *surface;
+    int width, height;
+    HBITMAP previous;
+    HDC src;
+
+    if (!(surface = get_composed_surface( child ))) return;
+    width = min( rect->right - rect->left, surface->rect.right - surface->rect.left );
+    height = min( rect->bottom - rect->top, surface->rect.bottom - surface->rect.top );
+    if ((src = NtGdiCreateCompatibleDC( 0 )))
+    {
+        window_surface_lock( surface );
+        previous = NtGdiSelectBitmap( src, surface->color_bitmap );
+        NtGdiAlphaBlend( hdc, rect->left, rect->top, width, height, src, 0, 0, width, height, *(DWORD *)&blend, 0 );
+        NtGdiSelectBitmap( src, previous );
+        window_surface_unlock( surface );
+        NtGdiDeleteObjectApp( src );
+    }
+    window_surface_release( surface );
+}
+
+/* repeat the last present of the parent of a layered child, so a change of the
+ * child shows without waiting for the parent's next frame */
+void x11drv_client_surface_represent_parent( HWND child )
+{
+    struct x11drv_client_surface *surface, *pending[16];
+    HWND parent = NtUserGetAncestor( child, GA_PARENT );
+    unsigned int i, count = 0;
+
+    pthread_mutex_lock( &client_surfaces_x11_lock );
+    LIST_FOR_EACH_ENTRY( surface, &client_surfaces_x11, struct x11drv_client_surface, entry )
+    {
+        if (count == ARRAY_SIZE(pending)) break;
+        if (surface->client.hwnd != parent || !surface->hdc_dst) continue;
+        if (!InterlockedCompareExchange( &surface->client.offscreen, 0, 0 )) continue;
+        client_surface_add_ref( &surface->client );
+        pending[count++] = surface;
+    }
+    pthread_mutex_unlock( &client_surfaces_x11_lock );
+
+    for (i = 0; i < count; i++)
+    {
+        TRACE( "presenting %s again for layered child %p\n", debugstr_client_surface( &pending[i]->client ), child );
+        client_surface_present( &pending[i]->client );
+        client_surface_release( &pending[i]->client );
+    }
+}
