+/* A layered child has no X window: its image stays in a surface of its own and
+ * is composed over its parent's presents, see is_ulw_child(). */
+static pthread_mutex_t composed_mutex = PTHREAD_MUTEX_INITIALIZER;
+static struct window_surface *composed_surfaces[32];
+
+static void composed_surface_set_clip( struct window_surface *surface, const RECT *rects, UINT count )
+{
+}
+
+static BOOL composed_surface_flush( struct window_surface *surface, const RECT *rect, const RECT *dirty,
+                                    const BITMAPINFO *color_info, const void *color_bits, BOOL shape_changed,
+                                    const BITMAPINFO *shape_info, const void *shape_bits )
+{
+    return TRUE;
+}
+
+static void composed_surface_destroy( struct window_surface *surface )
+{
+    unsigned int i;
+
+    pthread_mutex_lock( &composed_mutex );
+    for (i = 0; i < ARRAY_SIZE(composed_surfaces); i++)
+        if (composed_surfaces[i] == surface) composed_surfaces[i] = NULL;
+    pthread_mutex_unlock( &composed_mutex );
+}
+
+static const struct window_surface_funcs composed_surface_funcs =
+{
+    composed_surface_set_clip,
+    composed_surface_flush,
+    composed_surface_destroy
+};
+
+static BOOL create_composed_surface( HWND hwnd, const RECT *rect, struct window_surface **surface )
+{
+    char buffer[FIELD_OFFSET( BITMAPINFO, bmiColors[256] )];
+    BITMAPINFO *info = (BITMAPINFO *)buffer;
+    struct window_surface *previous = *surface, *created;
+    unsigned int i;
+
+    if (previous && previous->funcs == &composed_surface_funcs && EqualRect( &previous->rect, rect )) return TRUE;
+
+    memset( info, 0, sizeof(*info) );
+    info->bmiHeader.biSize        = sizeof(info->bmiHeader);
+    info->bmiHeader.biWidth       = rect->right - rect->left;
+    info->bmiHeader.biHeight      = -(rect->bottom - rect->top);
+    info->bmiHeader.biPlanes      = 1;
+    info->bmiHeader.biBitCount    = 32;
+    info->bmiHeader.biSizeImage   = get_dib_image_size( info );
+    info->bmiHeader.biCompression = BI_RGB;
+    if (!(created = window_surface_create( sizeof(*created), &composed_surface_funcs, hwnd, rect, info, 0 ))) return FALSE;
+
+    pthread_mutex_lock( &composed_mutex );
+    for (i = 0; i < ARRAY_SIZE(composed_surfaces); i++)
+        if (composed_surfaces[i] && composed_surfaces[i]->hwnd == hwnd) composed_surfaces[i] = NULL;
+    for (i = 0; i < ARRAY_SIZE(composed_surfaces); i++)
+        if (!composed_surfaces[i]) { composed_surfaces[i] = created; break; }
+    pthread_mutex_unlock( &composed_mutex );
+
+    if (previous) window_surface_release( previous );
+    *surface = created;
+    return TRUE;
+}
+
+struct window_surface *get_composed_surface( HWND hwnd )
+{
+    struct window_surface *surface = NULL;
+    unsigned int i;
+
+    pthread_mutex_lock( &composed_mutex );
+    for (i = 0; i < ARRAY_SIZE(composed_surfaces); i++)
+    {
+        if (!composed_surfaces[i] || composed_surfaces[i]->hwnd != hwnd) continue;
+        surface = composed_surfaces[i];
+        window_surface_add_ref( surface );
+        break;
+    }
+    pthread_mutex_unlock( &composed_mutex );
+    return surface;
+}
